{
  "name": "lpthw-learner",
  "private": true,
  "version": "0.1.0",
  "description": "Local-only Learn Python (LPTHW + Async/LLM + PyTorch) interactive learner",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "uv run uvicorn main:app --app-dir apps/server --reload --host 127.0.0.1 --port 8000",
    "dev": "npx concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "generate:content": "uv run python scripts/generate_content.py",
    "generate:lfs": "uv run python scripts/gen_llm_from_scratch.py",
    "install:web": "npm --prefix apps/web install",
    "install:api": "uv sync",
    "install:ml": "uv sync --extra ml"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
